{
  "name": "@schaefchens/scriptura-web",
  "version": "0.0.0",
  "description": "Scriptura for the web: the core in WebAssembly and a reader in the page, for any framework or none",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/schaefchens/scriptura.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "sh build.sh && tsc && cp -R src/generated dist/"
  },
  "dependencies": {
    "@schaefchens/scriptura": "*"
  },
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
