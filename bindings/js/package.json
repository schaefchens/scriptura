{
  "name": "@schaefchens/scriptura",
  "version": "0.0.0",
  "description": "Scriptura's shared TypeScript: the reader's types, its palette and fonts per script; and the import tool for texts",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "repository": { "type": "git", "url": "https://github.com/schaefchens/scriptura.git" },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fonts.json": "./fonts.json"
  },
  "bin": {
    "scriptura-import": "import.mjs"
  },
  "files": [
    "src",
    "fonts.json",
    "import.mjs"
  ]
}
