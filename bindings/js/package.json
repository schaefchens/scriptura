{
  "name": "@schaefchens/scriptura",
  "version": "0.0.0",
  "description": "Scriptura's shared TypeScript: the reader's types, its palette and fonts per script; and the import tool for texts",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/schaefchens/scriptura.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fonts.json": "./src/fonts.json"
  },
  "bin": {
    "scriptura-import": "import.mjs"
  },
  "scripts": {
    "build": "tsc"
  },
  "files": [
    "src",
    "dist",
    "import.mjs"
  ],
  "publishConfig": {
    "access": "public"
  }
}
