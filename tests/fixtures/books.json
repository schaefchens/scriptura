{"id":"jonah","code":"JON","title":"Jonah","work":"World English Bible","direction":"ltr","language":"en","chapters":[{"number":1,"label":"1","verses":[{"number":1,"label":"1","runs":[["Now Yahweh’s word came to Jonah the son of Amittai, saying,",null]],"notes":[{"kind":"footnote","mark":"1","at":12,"runs":[{"text":"1:1 ","role":"origin"},{"text":"“Yahweh” is God’s proper Name, sometimes rendered “LORD” (all caps) in other translations."}]}],"tags":[[0,[3,"H1961"]],[4,[6,"H3068"]],[13,[4,"H1697"]],[18,[4,"H1961"]],[23,[2,"H3068"]],[26,[5,"H3124"]],[32,[3,"H3068"]],[36,[3,"H1121"]],[40,[2,"H1121"]],[52,[6,"H1697"]]]},{"number":16,"label":"16","runs":[["Then the men feared Yahweh exceedingly; and they offered a sacrifice to Yahweh and made vows.",null]],"tags":[[0,[4,"H3068"]],[5,[3,"H3068"]],[9,[3,"H1419"]],[13,[6,"H3372"]],[20,[6,"H3068"]],[27,[11,"H1419"]],[40,[3,"H3068"]],[44,[4,"H3068"]],[49,[7,"H2076"]],[57,[1,"H3068"]],[59,[9,"H2077"]],[69,[2,"H3068"]],[72,[6,"H3068"]],[79,[3,"H3068"]],[83,[4,"H5087"]],[88,[4,"H5088"]]]},{"number":17,"label":"17","runs":[["Yahweh prepared a huge fish to swallow up Jonah, and Jonah was in the belly of the fish three days and three nights.",null]],"tags":[[0,[6,"H3068"]],[16,[1,"H3068"]]]}]},{"number":2,"label":"2","verses":[{"number":1,"label":"1","runs":[["Then Jonah prayed to Yahweh, his God, out of the fish’s belly.",null]],"tags":[[0,[4,"H1961"]],[5,[5,"H3124"]],[18,[2,"H3068"]],[21,[6,"H3068"]],[29,[3,"H3068"]],[33,[3,"H3068"]],[38,[3,"H1419"]],[42,[2,"H3068"]],[45,[3,"H3068"]],[49,[4,"H1709"]],[56,[5,"H4578"]]]},{"number":2,"label":"2","runs":[["He said, “I called because of my affliction to Yahweh. He answered me. Out of the belly of Sheol I cried. You heard my voice.",null]],"notes":[{"kind":"footnote","mark":"1","at":96,"runs":[{"text":"2:2 ","role":"origin"},{"text":"Sheol is the place of the dead."}]}],"tags":[[0,[2,"H3068"]],[10,[1,"H3068"]],[19,[7,"H3068"]],[27,[2,"H3068"]],[30,[2,"H3068"]],[44,[2,"H3068"]],[47,[6,"